# ESL Teacher Hub — root .htaccess (Apache/LiteSpeed, cPanel-compatible —
# every module-dependent directive below is <IfModule>-guarded so a missing
# module skips that feature instead of breaking the whole site)

# Disable directory browsing
Options -Indexes -MultiViews

# Friendly error pages
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# Block direct access to sensitive file types anywhere in the site
<FilesMatch "\.(sql|log|md|env|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Serve a clean /sitemap.xml URL from the dynamic sitemap.php generator
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Basic security headers (defense in depth — the app also sets its own
# security-relevant headers, e.g. X-Content-Type-Options on downloads)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache static assets — these are served with content-based/versioned
# paths in mind; if you update a CSS/JS file and don't see the change,
# hard-refresh or bump a ?v= query string on the asset link.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Force HTTPS — uncomment AFTER SSL is active (cPanel: SSL/TLS Status, or
# AutoSSL), otherwise you may get a redirect loop before the certificate
# is issued.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
