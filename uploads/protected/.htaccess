# Deny ALL direct web access to protected resource files.
# The only legitimate path to these files is member/download.php,
# which checks login + membership status before streaming the file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
